              "raw": "{\n  \"formName\": \"transaction-initiation\",\n  \"description\": \"Transaction initiation form\",\n  \"rspId\": 1,\n  \"fields\": [\n    {\n      \"referenceModel\": \"amount\",\n      \"visible\": true,\n      \"shortLabel\": \"Amount\"\n    },\n    {\n      \"referenceModel\": \"currency\",\n      \"visible\": true,\n      \"shortLabel\": \"Currency\"\n    }\n  ]\n}"
            },
            "url": {
