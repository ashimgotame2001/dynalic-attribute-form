{
  "info": {
    "name": "Dynamic Form Engine API",
    "description": "Comprehensive Postman collection for the Metadata-Driven Dynamic Form System.\n\n**Key Features:**\n- Form Configuration Management (Admin)\n- Public Form Operations\n- RSP Attribute Contract Management\n- RSP Related Attribute Management\n\n**Authentication:** Admin endpoints require Bearer token. Form submission may require user token.\n\n**Base URL:** http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Document Forms",
      "description": "APIs for generating dynamic forms for document types.",
      "item": [
        {
          "name": "Get Document Dynamic Form",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/document-forms?rspId=1&documentId={{document_id}}&service=customer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "document-forms"
              ],
              "query": [
                {
                  "key": "rspId",
                  "value": "1"
                },
                {
                  "key": "documentId",
                  "value": "{{document_id}}"
                },
                {
                  "key": "service",
                  "value": "customer",
                  "description": "The service module (customer, beneficiary, transaction)"
                }
              ]
            },
            "description": "Generates dynamic form metadata for a specific document type and RSP."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Form Configuration (Admin)",
      "description": "Admin APIs for managing form metadata configurations. Requires admin authentication.",
      "item": [
        {
          "name": "Create Customer Form Configuration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"formName\": \"customer-registration\",\n  \"description\": \"Customer registration form\",\n  \"rspId\": 1,\n  \"fields\": [\n    {\n      \"referenceModel\": \"user/secret\",\n      \"visible\": true,\n      \"shortLabel\": \"Secret\",\n      \"longLabel\": \"Enter secret password\",\n      \"validations\": [\n        {\n          \"type\": \"required\",\n          \"value\": true,\n          \"message\": \"Secret is required.\"\n        }\n      ]\n    },\n    {\n      \"referenceModel\": \"document\",\n      \"visible\": true,\n      \"shortLabel\": \"Supporting Documents\",\n      \"longLabel\": \"Please upload required documents\",\n      \"validations\": [\n        {\n          \"type\": \"minItems\",\n          \"value\": 1,\n          \"message\": \"At least one document is required.\"\n        }\n      ]\n    },\n    {\n      \"referenceModel\": \"document/documentType/id\",\n      \"visible\": true,\n      \"shortLabel\": \"Document Type\"\n    },\n    {\n      \"referenceModel\": \"document/documentNumber\",\n      \"visible\": true,\n      \"shortLabel\": \"Document Number\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/config/forms/customer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "config",
                "forms",
                "customer"
              ]
            },
            "description": "Creates a new form configuration for Customer with field specifications."
          },
          "response": []
        },
        {
          "name": "Create Beneficiary Form Configuration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
